datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  correo    String   @unique
  password  String
  rol       String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Condominio {
  id          Int      @id @default(autoincrement())
  nombre      String
  direccion   String
  telefono    String
  logo        String?
  createdAt   DateTime @default(now())

  condominos  Condomino[]
  pagos       Pago[]
  proveedores Proveedor[]
  egresos     Egreso[]
  inventario  Inventario[]
}

model Condomino {
  id            Int      @id @default(autoincrement())
  nombre        String
  vivienda      String
  telefono      String
  correo        String
  saldo         Float    @default(0)

  condominioId  Int
  condominio    Condominio @relation(fields: [condominioId], references: [id])

  pagos         Pago[]
  adeudos       Adeudo[]

  createdAt     DateTime @default(now())
}

model Pago {
  id            Int      @id @default(autoincrement())
  tipo          String
  descripcion   String
  monto         Float
  fecha         DateTime @default(now())

  condominoId   Int
  condomino     Condomino @relation(fields: [condominoId], references: [id])

  condominioId  Int
  condominio    Condominio @relation(fields: [condominioId], references: [id])
}

model Adeudo {
  id            Int      @id @default(autoincrement())
  concepto      String
  monto         Float
  pagado        Boolean  @default(false)
  fecha         DateTime @default(now())

  condominoId   Int
  condomino     Condomino @relation(fields: [condominoId], references: [id])
}

model Proveedor {
  id            Int      @id @default(autoincrement())
  nombre        String
  telefono      String
  correo        String
  tipo          String

  condominioId  Int
  condominio    Condominio @relation(fields: [condominioId], references: [id])

  egresos       Egreso[]

  createdAt     DateTime @default(now())
}

model Egreso {
  id            Int      @id @default(autoincrement())
  descripcion   String
  monto         Float
  fecha         DateTime @default(now())

  proveedorId   Int
  proveedor     Proveedor @relation(fields: [proveedorId], references: [id])

  condominioId  Int
  condominio    Condominio @relation(fields: [condominioId], references: [id])
}

model Inventario {
  id            Int      @id @default(autoincrement())
  nombre        String
  cantidad      Int
  descripcion   String?

  condominioId  Int
  condominio    Condominio @relation(fields: [condominioId], references: [id])

  createdAt     DateTime @default(now())
}